# GitHub API Token（用于提高 API 速率限制）
GITHUB_TOKEN=

# GitHub API Tokens（多个，逗号分隔，优先于 GITHUB_TOKEN）
# 多 token 配额感知轮询（跳过快耗尽的 token）+ 403/429 冷却切下一个
# 3 token × 5000 req/h = 15000 req/h，1000 仓库 60min 间隔仅用 13%
GITHUB_TOKENS=

# 追踪间隔（分钟）
TRACK_INTERVAL=30

# 要追踪的仓库列表（JSON 文件，仅 tracker 首次启动 seed 用）
REPOS_FILE=./backend/config/repositories.json

# SQLite 数据库路径
DB_PATH=./backend/data/tracker.db

# JSON 输出目录
EXPORT_DIR=./frontend/public/data

# 管理员账号（仅首次启动 seed 用，之后密码以 bcrypt hash 存 DB）
# 留空则跳过 seed（DB 已有 admin 时无需设置）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT 签名密钥（空则拒绝启动；32 字节以上为最佳实践）
JWT_SECRET=

# API server 监听地址
SERVER_ADDR=:8080

# true 时启用 CORS 允许 localhost:3000（仅开发）
SERVER_DEV=false

# 前端 admin fetch 的 baseURL（须 NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 站点正式域名（前端构建期注入 sitemap/robots/OG，未设置时回退占位符）
# 部署前必须设置为真实域名，否则 SEO 资产 URL 错误
SITE_URL=
